DATABASE_URL="postgresql://postgres:postgres@localhost:5432/html_behavior"
FRONTEND_URL=http://localhost:5173,http://localhost:5174



# development = developer inspector + /api/v1/dev/* enabled; anything else (production) = disabled (404)
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8002
LOG_LEVEL=INFO
MODEL_DIR=models
DATA_DIR=data
# Part 6A base model (hub name or a local folder); training on Colab, see configs/xlmr.yaml
XLMR_MODEL_NAME=xlm-roberta-base
DEVICE=cpu
# Part 9 B-1 /api/v1/analyze: serve the XLM-R text arm (CPU, ~1 GB RAM). false = DOM +
# behavior + TF-IDF only (verdict thresholds calibrated for that arm subset are used).
XLMR_ENABLED=true
# Browser origins allowed to call the C2 API (team frontend), comma-separated. Empty = no CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Part 9 B-2 ThreatRadar ingestion. SQLite results store (scan history, review queue; git-ignored).
RESULTS_DB=data/c2_results.db
# Shared secret ThreatRadar sends in the X-C2-Ingest-Key header of POST /api/v1/ingest.
# Empty = /api/v1/ingest disabled (503). Use a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=
# Background worker that analyzes queued URLs inside the API process (false = queue only).
INGEST_WORKER_ENABLED=true
