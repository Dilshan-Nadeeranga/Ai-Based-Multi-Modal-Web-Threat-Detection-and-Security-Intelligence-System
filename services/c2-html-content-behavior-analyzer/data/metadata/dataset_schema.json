{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C2 dataset sample metadata",
  "type": "object",
  "required": [
    "sample_id",
    "file_path",
    "label",
    "language",
    "source",
    "sha256",
    "verified"
  ],
  "properties": {
    "sample_id": {
      "type": "string"
    },
    "file_path": {
      "type": "string",
      "description": "Path relative to the service root"
    },
    "label": {
      "type": "string",
      "enum": [
        "benign",
        "phishing",
        "fake_ecommerce",
        "crypto_scam",
        "malware_delivery"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "si",
        "ta"
      ]
    },
    "source": {
      "type": "string",
      "description": "Dataset/feed the sample came from"
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "collection_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verified": {
      "type": "boolean"
    },
    "verified_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
