# Copy to .env and adjust. All values are optional; defaults are shown.

LOG_LEVEL=INFO

# Data root (relative paths are resolved against the service folder)
DATA_DIR=data

# --- Upload validation -----------------------------------------------------
MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_WIDTH=10000
MAX_IMAGE_HEIGHT=10000

# --- Preprocessing ---------------------------------------------------------
# Processed images are fitted inside this box, keeping aspect ratio (no upscaling)
PROCESSED_MAX_WIDTH=1024
PROCESSED_MAX_HEIGHT=1024
# Background used when flattening transparent images, as a JSON list
PROCESSED_BACKGROUND_COLOR=[255,255,255]

# --- Perceptual hashing ----------------------------------------------------
PHASH_HASH_SIZE=8
# Hamming distance <= threshold => near duplicate (0 => exact duplicate)
PHASH_NEAR_DUPLICATE_THRESHOLD=5

# --- OCR (Tesseract) -------------------------------------------------------
OCR_ENGINE=tesseract
# English + Sinhala + Tamil; missing packs fall back to the installed subset
OCR_LANGUAGES=eng+sin+tam
OCR_FALLBACK_LANGUAGE=eng
# Leave empty to use tesseract from PATH.
# Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# Words below this confidence (0-100) are dropped from OCR output
OCR_MIN_WORD_CONFIDENCE=0
# Log a warning when the average confidence is below this value
OCR_LOW_CONFIDENCE_WARNING=60
# Tesseract page segmentation mode / OCR engine mode
OCR_PSM=3
OCR_OEM=3
OCR_TIMEOUT_SECONDS=60
# Longest side of the image given to OCR (larger originals are downscaled)
OCR_MAX_SIDE=3000

# --- Multimodal dataset ----------------------------------------------------
# Written into every sample record (major.minor or major.minor.patch)
DATASET_VERSION=0.1
DATASET_MAX_IMAGES_PER_SAMPLE=20
DATASET_MAX_URLS_PER_SAMPLE=50
DATASET_MAX_TEXT_LENGTH=20000
# Keep false for the research dataset: synthetic_test samples are refused
DATASET_ALLOW_SYNTHETIC=false
# Seconds to wait for the dataset write lock before answering DATASET_BUSY
DATASET_LOCK_TIMEOUT_SECONDS=10

# --- Destination web capture (Playwright / headless Chromium) --------------
WEB_CAPTURE_ENABLED=true
# Whole page budget: navigation + waiting + screenshot
WEB_CAPTURE_TIMEOUT_SECONDS=30
# Extra wait after the page has loaded (late scripts, animations)
WEB_CAPTURE_SETTLE_SECONDS=2
WEB_CAPTURE_VIEWPORT_WIDTH=1366
WEB_CAPTURE_VIEWPORT_HEIGHT=768
# Full-page screenshots taller than this are cut (screenshot_truncated=true)
WEB_CAPTURE_MAX_HEIGHT=12000
WEB_CAPTURE_JAVASCRIPT=true
# Keep true: social-media platforms are never opened by the capture browser
WEB_CAPTURE_BLOCK_SOCIAL_MEDIA=true
# Keep false: pages may not reach localhost / private networks (SSRF protection)
WEB_CAPTURE_ALLOW_PRIVATE_HOSTS=false
# Empty = Chromium's default user agent
WEB_CAPTURE_USER_AGENT=
WEB_CAPTURE_MAX_TITLE_LENGTH=300
