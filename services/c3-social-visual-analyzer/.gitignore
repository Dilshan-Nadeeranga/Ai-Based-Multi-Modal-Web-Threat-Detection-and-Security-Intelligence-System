# Dataset files: raw evidence, images and screenshots may be large or contain
# suspicious material, so they stay out of Git. Folder placeholders (.gitkeep)
# stay tracked. Annotation JSON/JSONL and statistics are small text records and
# are intentionally NOT ignored. Test fixtures live in tests/fixtures/.
data/raw/**
data/processed/**
data/rejected/**
data/webpage_screenshots/**
data/reference/**
!data/raw/**/
!data/processed/**/
!data/rejected/**/
!data/webpage_screenshots/**/
!data/reference/**/
!data/**/.gitkeep
data/annotations/*.tmp
data/annotations/.dataset.lock
data/statistics/*.tmp

# Trained model weights (large; regenerate with scripts/train_text_baseline.py)
models/
