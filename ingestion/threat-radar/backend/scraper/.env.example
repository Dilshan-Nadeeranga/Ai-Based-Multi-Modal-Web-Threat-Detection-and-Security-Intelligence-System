# Telegram API credentials (from https://my.telegram.org/apps)
API_ID=12345678
API_HASH=your_api_hash_here
PHONE=+94771234567

# Telegram session file name (stored in scraper/ folder)
TELEGRAM_SESSION_NAME=scraper_session

# Channels to scrape (comma-separated, without @)
# Leave empty + set TELEGRAM_AUTO_FIND_CHANNELS=true to auto-discover
TELEGRAM_SCRAPE_CHANNELS=

# Auto-discover channels using keywords as search seeds
TELEGRAM_AUTO_FIND_CHANNELS=false
TELEGRAM_AUTO_FIND_MAX_CHANNELS=20
TELEGRAM_AUTO_FIND_LIMIT_PER_QUERY=40

# Lookback window for batch mode
TELEGRAM_LOOKBACK_DAYS=7
TELEGRAM_FROM_DATE=
TELEGRAM_TO_DATE=
TELEGRAM_FORCE_LOOKBACK=true

# Max messages to read per channel in batch mode
TELEGRAM_MAX_MESSAGES_PER_CHANNEL=2000

# Path to keyword file managed by the backend
# Defaults to ../backend/data/keywords.json  (relative to scraper/)
KEYWORDS_FILE=

# Fallback keywords if keywords.json is empty (comma-separated)
TELEGRAM_SCRAPE_KEYWORDS=

# Extra domains to whitelist (comma-separated)
TELEGRAM_KNOWN_HOST_WHITELIST=

# Output folder — defaults to ../backend/data/scraped/
SCRAPED_OUTPUT_DIR=
