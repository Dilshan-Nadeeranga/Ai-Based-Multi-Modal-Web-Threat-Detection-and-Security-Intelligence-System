# domains-monitor.com API token
DOMAINS_MONITOR_TOKEN=your_token_here

# Server
PORT=4000

# Upstream API
API_BASE_URL=https://domains-monitor.com/api/v1
HTTP_TIMEOUT_SECONDS=600

# Saved files (relative to backend/ folder → backend/data/downloads)
DOWNLOAD_DIR=data/downloads

# Daily auto-download (runs while backend server is running)
AUTO_DOWNLOAD=true
# Cron is UTC. Example: 7:45 PM Sri Lanka = 14:15 UTC
DOWNLOAD_CRON=15 14 * * *
DAILY_ZONE=dailyupdate
DAILY_FORMAT=text

DATABASE_URL=
B2_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET=your_bucket_name
B2_ENDPOINT=s3.us-west-004.backblazeb2.com
# Top folder in the bucket. Each source is added under it: images/reddit/, images/telegram/.
B2_IMAGE_PREFIX=images

# Optional extra brands for mimicry detection (comma-separated)
# DOMAIN_FILTER_BRANDS=hsbc,dbs,sampath

# ── Telegram Scraper ─────────────────────────────────────────────
# Run scraper in ONE place only (Render OR local — never both).
# Production (Render): SCRAPER_ENABLED=true
# Local machine:       SCRAPER_ENABLED=false  (default)
# Local scraper dev:    SCRAPER_ENABLED=true + SCRAPER_ALLOW_LOCAL=true
SCRAPER_ENABLED=false
SCRAPER_ALLOW_LOCAL=false
SCRAPER_MODE=scheduled
SCRAPER_INTERVAL_MINUTES=10
SCRAPER_START_DELAY_SECONDS=30

# Python binary name (python3 on Linux/Mac, python on Windows)
PYTHON_BIN=python3

# Telegram API credentials (from https://my.telegram.org/apps)
API_ID=
API_HASH=
PHONE=

# Telegram session file name (stored in backend/scraper/)
TELEGRAM_SESSION_NAME=scraper_session

# OPTIONAL — only for surviving Render redeploys without re-login:
# 1. Log in via frontend first
# 2. GET /api/auth/export-session → copy sessionB64
# 3. Set TELEGRAM_SESSION_B64=<value> and TELEGRAM_RESTORE_SESSION_B64=true
# Do NOT set TELEGRAM_SESSION_B64 if you use frontend login (causes dual-IP session death).
TELEGRAM_SESSION_B64=
TELEGRAM_RESTORE_SESSION_B64=false

# Channels to watch (comma-separated, no @). Leave empty + AUTO_FIND=true to auto-discover.
TELEGRAM_SCRAPE_CHANNELS=

# Scam keywords — also managed via the frontend UI (backend/data/keywords.json takes priority)
# On Render (data/ resets on redeploy), set comma-separated keywords here:
SCAM_KEYWORDS=earn money,crypto airdrop
TELEGRAM_SCRAPE_KEYWORDS=

# Auto-discover channels using keywords as search seeds
TELEGRAM_AUTO_FIND_CHANNELS=false
TELEGRAM_AUTO_FIND_MAX_CHANNELS=20

# Lookback window for batch mode
TELEGRAM_LOOKBACK_DAYS=7
TELEGRAM_TODAY_ONLY=true
TELEGRAM_FORCE_LOOKBACK=false
TELEGRAM_MAX_MESSAGES_PER_CHANNEL=2000

# Extra domains to whitelist (comma-separated)
TELEGRAM_KNOWN_HOST_WHITELIST=

# ── Reddit Scraper ───────────────────────────────────────────────
# Uses public RSS feeds — no Reddit API app required.
REDDIT_SCRAPER_ENABLED=false
REDDIT_SCRAPER_MODE=continuous

# Python collector: playwright reads public old.reddit.com pages (text, images, links).
# rss uses the lightweight feed when the browser is unavailable.
REDDIT_ENGINE=playwright
# Node side: true keeps the Python collector (no second Playwright login scraper).
REDDIT_USE_RSS_ONLY=true
REDDIT_FETCH_COMMENT_JSON=true

# Include your Reddit username — helps avoid blocks
REDDIT_USER_AGENT=ThreatRadar/1.0 (by u/your_reddit_username)

# Set false to open visible browser during login (helps with CAPTCHA)
REDDIT_LOGIN_HEADLESS=true
# Scraper uses same headless setting unless overridden (false = visible browser, less blocking)
REDDIT_SCRAPE_HEADLESS=

# Render: Build Command = `npm install && npm run build`
# Do NOT set PLAYWRIGHT_BROWSERS_PATH=0 — the app uses backend/.playwright-browsers automatically.
# Recommended:
# PLAYWRIGHT_SKIP_BROWSER_GC=1

# Base64 Playwright storageState JSON for cloud deploy (Render backend — NOT Vercel)
# 1. Local: npm run reddit:login  then  npm run reddit:encode
# 2. Paste the ONE long base64 line (no quotes, no spaces) into Render env
# 3. Redeploy Render backend
REDDIT_SESSION_B64=

# Subreddits to watch (comma-separated). Also managed via frontend UI.
REDDIT_SCRAPE_SUBREDDITS=

# Auto-discover subreddits using keywords as search seeds
REDDIT_AUTO_FIND_SUBREDDITS=true
REDDIT_AUTO_FIND_MAX_SUBREDDITS=15

# Lookback window for batch mode
REDDIT_LOOKBACK_DAYS=7
REDDIT_MAX_POSTS_PER_SUBREDDIT=500
REDDIT_POLL_INTERVAL_SECONDS=300
REDDIT_REQUEST_DELAY_SECONDS=8

# Extra domains to whitelist (comma-separated)
REDDIT_KNOWN_HOST_WHITELIST=
