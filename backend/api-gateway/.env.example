PORT=5000
NODE_ENV=development

# PostgreSQL (the gateway owns users, analysis_records and code_audit_scans)
DATABASE_URL=postgresql://scamtrace_app:password@localhost:5432/scamtrace

# JWT — use a long random value (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=1h

# Allowed browser origin(s), comma-separated
FRONTEND_URL=http://localhost:5173

# Internal analyzer services (called only by the gateway)
C1_URL=http://localhost:8001
C2_URL=
C3_URL=
C4_URL=http://localhost:8000

# Optional rate limits for /api/auth/login and /api/auth/register (per IP per window)
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_MAX=10
# REGISTER_RATE_LIMIT_MAX=5
